# ClipForge AI — Environment Configuration
# Copy this file to .env and adjust as needed. Never commit .env with real credentials.

# Application Environment
CLIPFORGE_ENV=development
CLIPFORGE_DEBUG=true
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# Storage Directories
CLIPFORGE_DATA_DIR=clipforge-data

# External LLM Configuration (Provider-Independent)
CLIPFORGE_LLM_API_BASE=https://api.openai.com/v1
CLIPFORGE_LLM_API_KEY=
CLIPFORGE_LLM_MODEL=gpt-4o-mini
CLIPFORGE_LLM_PROTOCOL=openai_compatible
CLIPFORGE_LLM_MAX_TOKENS=4000
CLIPFORGE_LLM_TIMEOUT=60.0

# Hardware & Inference Defaults
CLIPFORGE_DEVICE=cpu
CLIPFORGE_COMPUTE_TYPE=int8
CLIPFORGE_MODEL_SIZE=base
CLIPFORGE_CPU_THREADS=4

